RewriteEngine On

# ------------------------------------
# 1. Redirect .php URLs to clean URLs
# ------------------------------------
RewriteCond %{THE_REQUEST} \s/([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# ------------------------------------
# 2. Load .php file for clean URLs
# ------------------------------------
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^.]+)$ $1.php [L]
